{
  "info": {
    "name": "RoomCare - Phase 2 APIs",
    "description": "API collection for RoomCare Phase 2 - Property, Room & Tenant Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
