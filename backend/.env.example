# Cau hinh bien moi truong cho xac thuc Gmail & OTP SMS that (RoomCare Backend)
# Sao chep thanh .env hoac thiet lap bien moi truong he thong — TUYET DOI KHONG commit .env len GitHub

# -----------------------------------------------------
# 1. GMAIL SMTP (Gui OTP xac thuc & quen mat khau qua Email)
# -----------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-roomcare-sender@gmail.com
# Dung Gmail App Password 16 ky tu viet lien (KHONG dung mat khau dang nhap Gmail thuong)
MAIL_PASSWORD=your16charapppwd
MAIL_FROM=your-roomcare-sender@gmail.com
MAIL_FROM_NAME=RoomCare

# -----------------------------------------------------
# 2. TWILIO VERIFY / SMS (Gui OTP SMS that cho SDT Viet Nam +84)
# Khuyen nghi dung Twilio Verify (TWILIO_VERIFY_SERVICE_SID) vi ho tro OTP cho +84 va tu quan ly ma xac minh
# Hoac dien TWILIO_FROM_NUMBER / TWILIO_MESSAGING_SERVICE_SID neu dung Programmable SMS
# -----------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_TIMEOUT_SECONDS=10

# -----------------------------------------------------
# 3. CHINH SACH VONG DOI OTP & BAO MAT (Mac dinh theo chuan he thong)
# -----------------------------------------------------
AUTH_OTP_EXPIRATION_MINUTES=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_REQUESTS_PER_HOUR=5
AUTH_OTP_MAX_REQUESTS_PER_IP_PER_HOUR=20
AUTH_OTP_MAX_ATTEMPTS=5
APP_BASE_URL=http://localhost:8080
