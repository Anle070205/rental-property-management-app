# Cau hinh Gmail SMTP cho RoomCare Backend
# Sao chep file nay thanh .env hoac thiet lap trong bien moi truong he thong (KHONG commit .env len Git)

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-roomcare-sender@gmail.com
# Su dung Gmail App Password (16 ky tu, viet lien khong dau cach), KHONG dung mat khau dang nhap Gmail thuong
MAIL_PASSWORD=your16charapppwd
MAIL_FROM=your-roomcare-sender@gmail.com
MAIL_FROM_NAME=RoomCare

# Thoi gian het han & chong spam OTP
AUTH_OTP_EXPIRATION_MINUTES=10
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_REQUESTS_PER_HOUR=5
AUTH_OTP_MAX_ATTEMPTS=5

# Base URL cua backend de tao lien ket xac thuc trong email
APP_BASE_URL=http://localhost:8080
