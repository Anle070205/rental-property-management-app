<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rc_canvas">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/RoomCare.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/room_detail"
            app:titleTextAppearance="@style/RoomCare.Title" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/rc_line" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Hero Price & Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rc_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rc_badge_success"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/success"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Còn trống" />

                <TextView
                    android:id="@+id/tvRoomCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/rc_ink"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="Phòng P101" />

                <TextView
                    android:id="@+id/tvPropertyInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/rc_muted"
                    android:textSize="13sp"
                    tools:text="Nhà trọ Xanh E2E • 88 Nguyễn Văn Cừ, Q5" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/rc_line" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giá thuê hàng tháng"
                    android:textColor="@color/rc_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvRentPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/rc_brand"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="3.500.000 ₫/tháng" />

                <TextView
                    android:id="@+id/tvSpecs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/rc_ink"
                    android:textSize="13sp"
                    tools:text="Tầng 1 • 25 m² • Tối đa 2 người • Đặt cọc: 3.500.000 ₫" />
            </LinearLayout>

            <!-- Health Score Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/rc_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_health"
                        app:tint="@color/health_good" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Chỉ số tình trạng phòng (Health Score)"
                        android:textColor="@color/rc_ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHealthScoreValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rc_badge_success"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/health_good"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="100/100 • Tốt" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressHealth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    app:indicatorColor="@color/health_good"
                    app:trackColor="@color/surface_variant"
                    app:trackCornerRadius="999dp"
                    app:trackThickness="7dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/rc_tenant_health_score_explain"
                    android:textColor="@color/rc_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Utilities, Amenities & Description Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/rc_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chi phí điện, nước &amp; dịch vụ"
                    android:textColor="@color/rc_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvUtilities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/rc_ink"
                    android:textSize="14sp"
                    tools:text="Điện: 3.500 ₫/kWh • Nước: 15.000 ₫/m³ • Wifi: 100.000 ₫" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/rc_line" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trang thiết bị &amp; tiện nghi"
                    android:textColor="@color/rc_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvAmenities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/rc_ink"
                    android:textSize="14sp"
                    tools:text="Điều hòa, Bình nóng lạnh, Giường, Tủ quần áo, Wifi" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/rc_line" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mô tả chi tiết"
                    android:textColor="@color/rc_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.25"
                    android:textColor="@color/rc_ink"
                    android:textSize="14sp"
                    tools:text="Phòng mới sửa, thoáng mát, có ban công riêng." />
            </LinearLayout>

            <!-- Landlord Contact & Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/rc_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thông tin chủ nhà"
                    android:textColor="@color/rc_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvLandlordContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/rc_ink"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Chủ trọ: Nguyễn Văn A • 0901234567" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCallLandlord"
                    style="@style/RoomCare.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/rc_call_landlord"
                    app:icon="@drawable/ic_phone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnContactLandlord"
                    style="@style/RoomCare.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/rc_contact_landlord"
                    app:icon="@drawable/ic_email" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBookRoom"
                    style="@style/RoomCare.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/rc_book_room_now"
                    app:icon="@drawable/ic_check" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/rc_brand"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/rc_danger" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            style="@style/RoomCare.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/rc_retry" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
