<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/RoomCare.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/rc_icon_box_warning">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bolt"
                    app:tint="@color/warning" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRoomAndMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rc_ink"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Phòng 102 • Kỳ 11/2026" />

                <TextView
                    android:id="@+id/tvPropertyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rc_muted"
                    android:textSize="12sp"
                    tools:text="Nhà trọ An Phúc" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvInvoiceLockBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_rounded"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Chưa chốt" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvElectricDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/rc_ink"
            android:textSize="13sp"
            tools:text="Điện: 1200 → 1350 (150 kWh) = 525.000 ₫" />

        <TextView
            android:id="@+id/tvWaterDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/rc_ink"
            android:textSize="13sp"
            tools:text="Nước: 80 → 88 (8 m³) = 120.000 ₫" />

        <TextView
            android:id="@+id/tvServiceDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/rc_muted"
            android:textSize="12sp"
            tools:text="Internet: 100.000 ₫ • Dịch vụ: 50.000 ₫" />

        <TextView
            android:id="@+id/tvHistorySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/rc_muted"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Lịch sử: Đã cập nhật ngày 15/11" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/rc_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTotalUtility"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/rc_brand"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Tổng: 795.000 ₫" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditRecord"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit"
                android:textColor="@color/rc_brand"
                app:icon="@drawable/ic_edit"
                app:iconTint="@color/rc_brand" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
