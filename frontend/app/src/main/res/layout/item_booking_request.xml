<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/RoomCare.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rc_badge"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:textColor="@color/rc_brand"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Đặt phòng" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rc_badge_warning"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:textColor="@color/warning"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Chờ duyệt" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRoomTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/rc_ink"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Phòng P101 • Nhà trọ Xanh E2E" />

        <TextView
            android:id="@+id/tvPriceAndScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/rc_brand"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="3.500.000 ₫/tháng • Health Score: 100/100" />

        <TextView
            android:id="@+id/tvCounterpart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/rc_ink"
            android:textSize="13sp"
            tools:text="Người thuê: Nguyễn An • 0981234562" />

        <TextView
            android:id="@+id/tvMoveInDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/rc_muted"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Dự kiến dọn vào: 27/11/2026"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/rc_soft_banner"
            android:padding="10dp"
            android:textColor="@color/rc_ink"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Lời nhắn: Em muốn xem phòng vào cuối tuần này."
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvLandlordNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/rc_brand_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Phản hồi chủ nhà: Mời bạn đến xem lúc 9h sáng."
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCall"
                style="@style/RoomCare.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="40dp"
                android:paddingHorizontal="12dp"
                android:text="Gọi điện"
                android:textSize="12sp"
                app:icon="@drawable/ic_phone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/RoomCare.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:minHeight="40dp"
                android:paddingHorizontal="12dp"
                android:text="Hủy yêu cầu"
                android:textColor="@color/rc_danger"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReject"
                style="@style/RoomCare.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:minHeight="40dp"
                android:paddingHorizontal="12dp"
                android:text="Từ chối"
                android:textColor="@color/rc_danger"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApprove"
                style="@style/RoomCare.Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:minHeight="40dp"
                android:paddingHorizontal="12dp"
                android:text="Duyệt"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
