<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rc_canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RoomCare / ADMIN"
            android:textColor="@color/rc_brand"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Chi tiết nhà trọ"
            android:textColor="@color/rc_ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Dữ liệu tổng hợp · Chỉ xem"
            android:textColor="@color/rc_muted"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/rc_tint_soft"
            android:text="‹ Danh sách nhà trọ"
            android:textAllCaps="false"
            android:textColor="@color/rc_brand_dark"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:elevation="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rc_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_prop_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/rc_ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_prop_code_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="--"
                android:textColor="@color/rc_brand"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Địa chỉ: --"
                android:textColor="@color/rc_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_owner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Chủ sở hữu: --"
                android:textColor="@color/rc_ink"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_owner"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/rc_tint_soft"
                android:text="Xem hồ sơ chủ sở hữu"
                android:textAllCaps="false"
                android:textColor="@color/rc_brand_dark"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:elevation="0dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rc_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_room_tenant_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 phòng · 0 người thuê"
                android:textColor="@color/rc_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_room_breakdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 đang thuê · 0 trống · 0 bảo trì"
                android:textColor="@color/rc_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_occupancy_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tỷ lệ lấp đầy: 0%"
                android:textColor="@color/rc_brand_dark"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Tra cứu phòng đang thuê"
            android:textColor="@color/rc_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/ll_occupied_rooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/rc_pill_tint"
            android:padding="12dp"
            android:text="Chỉ xem thông tin. Mọi thay đổi phòng, hợp đồng và hóa đơn được thực hiện bởi chủ nhà đang quản lý."
            android:textColor="@color/rc_brand_dark"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
