<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/RoomCare.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvScoreCircle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/rc_icon_box_tint"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="54" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRoomTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rc_ink"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="P.305 • Nhà trọ An Phúc" />

                <TextView
                    android:id="@+id/tvTenantAndStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/rc_muted"
                    android:textSize="12sp"
                    tools:text="Đang thuê • Phạm Gia Bảo" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRatingBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_rounded"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="3dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="Rủi ro" />

                    <TextView
                        android:id="@+id/tvTrend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="↓ -6 điểm" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="100"
            app:trackColor="@color/surface_variant"
            app:trackCornerRadius="999dp"
            app:trackThickness="7dp" />

        <TextView
            android:id="@+id/tvFactorSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/rc_muted"
            android:textSize="12sp"
            tools:text="Thanh toán: 20/40 • Hợp đồng: 25/25 • Điện nước: 20/20" />

        <TextView
            android:id="@+id/tvDeductionOrTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/rc_ink"
            android:textSize="12sp"
            tools:text="Lưu ý: Hóa đơn kỳ này đang trễ hạn" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
