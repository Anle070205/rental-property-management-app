<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rc_canvas"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/RoomCare.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/rc_my_room"
        app:titleTextAppearance="@style/RoomCare.Title" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/rc_line" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:indeterminateTint="@color/rc_brand"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/rc_muted"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/retry"
        style="@style/RoomCare.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/rc_retry"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExploreRooms"
        style="@style/RoomCare.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="@string/rc_browse_properties"
        android:visibility="gone"
        app:icon="@drawable/ic_search" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/sample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/rc_soft_banner"
                android:padding="10dp"
                android:text="@string/rc_tenant_sample"
                android:textColor="@color/rc_brand"
                android:textSize="12sp" />

            <!-- Room Hero Card (Figma 34:23805) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rc_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRoomStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/rc_badge_success"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Đang thuê"
                            android:textColor="@color/success"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/roomCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/rc_ink"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="P.305 · Tầng 3" />

                        <TextView
                            android:id="@+id/tvRoomSpecs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/rc_muted"
                            android:textSize="13sp"
                            tools:text="24 m² · Đang ở 1/2 người" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/rc_icon_box_tint">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_room"
                            app:tint="@color/rc_brand" />
                    </FrameLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/rc_line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/rentPrice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/rc_brand"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Giá thuê: 3.800.000 ₫" />

                    <TextView
                        android:id="@+id/tvDeposit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/rc_muted"
                        android:textSize="13sp"
                        tools:text="Cọc: 7.600.000 ₫" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHealthScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rc_badge_success"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/health_good"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Health Score: 100/100" />
            </LinearLayout>

            <!-- Contract Card (Figma 34:23805) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hợp đồng thuê"
                    android:textColor="@color/rc_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnViewContract"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="Xem chi tiết"
                    android:textColor="@color/rc_brand"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/rc_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvContractCodeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rc_ink"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Hợp đồng: HD-2026-P305 · Đang hiệu lực" />

                <TextView
                    android:id="@+id/tvContractPeriod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/rc_muted"
                    android:textSize="13sp"
                    tools:text="Thời hạn: 01/11/2025 – 31/10/2026" />

                <TextView
                    android:id="@+id/tvContractPaymentDay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/rc_muted"
                    android:textSize="13sp"
                    tools:text="Ngày thanh toán: Ngày 05 hàng tháng" />

                <TextView
                    android:id="@+id/tvPrimaryAndRoommates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/rc_ink"
                    android:textSize="13sp"
                    tools:text="Người thuê chính: Phạm Gia Bảo" />
            </LinearLayout>

            <!-- Room Info, Utilities & Amenities Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Thông tin phòng, điện nước &amp; tiện nghi"
                android:textColor="@color/rc_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/rc_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/rc_icon_box_soft">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home"
                            app:tint="@color/rc_brand" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/address"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/rc_ink"
                        android:textSize="14sp"
                        tools:text="Địa chỉ: Nhà trọ An Phúc" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/rc_line" />

                <TextView
                    android:id="@+id/tvUtilityFees"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rc_ink"
                    android:textSize="13sp"
                    tools:text="Điện: 3.500 ₫/kWh · Nước: 15.000 ₫/m³ · Wifi: 100.000 ₫ · Dịch vụ: 50.000 ₫" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/rc_line" />

                <TextView
                    android:id="@+id/amenities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rc_ink"
                    android:textSize="14sp"
                    tools:text="Tiện ích: Điều hòa, Nóng lạnh, Wifi" />

                <TextView
                    android:id="@+id/tvRoomDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/rc_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Latest Invoice Card (Figma 34:23805) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hóa đơn gần nhất"
                    android:textColor="@color/rc_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnViewInvoices"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="Xem tất cả"
                    android:textColor="@color/rc_brand"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/rc_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLatestInvoiceMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/rc_ink"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Kỳ 2026-11" />

                    <TextView
                        android:id="@+id/tvLatestInvoiceAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/rc_muted"
                        android:textSize="13sp"
                        tools:text="4.950.000 ₫" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLatestInvoiceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rc_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/rc_brand"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Đã thanh toán" />
            </LinearLayout>

            <!-- Landlord Contact & Quick Actions Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Liên hệ chủ trọ &amp; Thao tác"
                android:textColor="@color/rc_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rc_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/rc_icon_box_tint">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_person"
                            app:tint="@color/rc_brand" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/landlord"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/rc_ink"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Liên hệ chủ nhà: Nguyễn Văn A · 0901234567" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dial"
                    style="@style/RoomCare.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/rc_call_landlord"
                    app:icon="@drawable/ic_phone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReportIncident"
                        style="@style/RoomCare.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="Báo sự cố"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuestStay"
                        style="@style/RoomCare.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Khách lưu trú"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_qr_code" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
