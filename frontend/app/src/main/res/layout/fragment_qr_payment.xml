<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" >
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" app:title="@string/rc_payment_qr" app:navigationIcon="@drawable/ic_arrow_back" />
    <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content"  />
    <com.google.android.material.button.MaterialButton android:id="@+id/retry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rc_retry" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/content" android:padding="24dp">
    <TextView android:id="@+id/sample" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rc_payment_sample" android:textStyle="bold" />
    <ImageView android:id="@+id/qr" android:layout_width="240dp" android:layout_height="240dp" android:layout_gravity="center_horizontal" android:contentDescription="@string/rc_payment_qr_image" />
    <TextView android:id="@+id/qrError" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rc_payment_qr_error" />
    <TextView android:id="@+id/bank" android:layout_width="match_parent" android:layout_height="wrap_content"  />
    <TextView android:id="@+id/account" android:layout_width="match_parent" android:layout_height="wrap_content"  />
    <TextView android:id="@+id/amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="20sp" android:textColor="@color/rc_primary" />
    <TextView android:id="@+id/reference" android:layout_width="match_parent" android:layout_height="wrap_content"  />
    <com.google.android.material.button.MaterialButton android:id="@+id/copyAccount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rc_payment_copy_account" />
    <com.google.android.material.button.MaterialButton android:id="@+id/copyReference" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rc_payment_copy_content" />
    <TextView android:id="@+id/instructions" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rc_payment_instructions" />
</LinearLayout>
    </ScrollView>
</LinearLayout>
