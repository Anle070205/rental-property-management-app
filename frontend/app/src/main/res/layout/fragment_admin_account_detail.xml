<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rc_canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RoomCare / ADMIN"
            android:textColor="@color/rc_brand"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Chi tiết tài khoản"
            android:textColor="@color/rc_ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tra cứu tài khoản"
            android:textColor="@color/rc_muted"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/rc_tint_soft"
            android:text="‹ Danh sách tài khoản"
            android:textAllCaps="false"
            android:textColor="@color/rc_brand_dark"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:elevation="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rc_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_initials"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/rc_pill_tint"
                android:gravity="center"
                android:text="TK"
                android:textColor="@color/rc_brand_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="--"
                android:textColor="@color/rc_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/rc_pill_tint"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Đang hoạt động"
                android:textColor="@color/rc_brand_dark"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Vai trò / Mã tài khoản"
                android:textColor="@color/rc_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_role_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/rc_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Email"
                android:textColor="@color/rc_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/rc_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Số điện thoại"
                android:textColor="@color/rc_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/rc_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ngày tạo"
                android:textColor="@color/rc_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_created_at"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/rc_ink"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_tenant_unit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rc_panel"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đơn vị đang quản lý"
                android:textColor="@color/rc_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_managing_landlord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Chủ nhà: --"
                android:textColor="@color/rc_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_managing_property_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Nhà trọ / Phòng: --"
                android:textColor="@color/rc_muted"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_landlord"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/rc_tint_soft"
                android:text="Xem chủ nhà đang quản lý"
                android:textAllCaps="false"
                android:textColor="@color/rc_brand_dark"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:elevation="0dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_scope_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rc_pill_tint"
            android:padding="12dp"
            android:text="ADMIN chỉ tra cứu thông tin truy cập. Phòng, hợp đồng và hóa đơn do chủ nhà quản lý."
            android:textColor="@color/rc_brand_dark"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_account"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/rc_tint_soft"
            android:text="Chỉnh sửa thông tin tài khoản"
            android:textAllCaps="false"
            android:textColor="@color/rc_brand_dark"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:elevation="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_lock"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/rc_danger"
            android:text="Khóa tài khoản"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:elevation="0dp" />

    </LinearLayout>
</ScrollView>
