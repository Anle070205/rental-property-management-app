<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/rc_canvas">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<TextView android:id="@+id/avatar" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center"
    android:background="@drawable/rc_badge" android:textColor="@color/rc_brand" android:textStyle="bold" />
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/RoomCare.Caption" android:text="@string/rc_home_hello" />
<TextView android:id="@+id/greeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/RoomCare.Title" android:text="@string/rc_tenant_home" />
</LinearLayout>
<ImageButton android:id="@+id/notificationBell" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/rc_bell"
    android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/rc_notifications" />
</LinearLayout>
<ProgressBar android:id="@+id/progress" android:layout_width="32dp" android:layout_height="32dp" android:indeterminateTint="@color/rc_brand" android:visibility="gone" />
<TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/rc_danger" android:visibility="gone" />
<com.google.android.material.button.MaterialButton android:id="@+id/retry" style="@style/RoomCare.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rc_retry" android:visibility="gone" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/RoomCare.Section" android:text="@string/rc_active_room" android:layout_marginTop="16dp" android:layout_marginBottom="6dp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/rc_panel" android:padding="14dp" android:layout_marginBottom="10dp">
<TextView android:id="@+id/roomCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/RoomCare.Title" />
<com.google.android.material.button.MaterialButton android:id="@+id/room" style="@style/RoomCare.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rc_my_room" app:icon="@drawable/ic_room" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/rc_panel" android:padding="14dp" android:layout_marginBottom="10dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/RoomCare.Caption" android:text="@string/rc_tenant_amount_due" />
<TextView android:id="@+id/amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/rc_ink" />
<TextView android:id="@+id/dueDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/rc_danger" />
<com.google.android.material.button.MaterialButton android:id="@+id/invoices" style="@style/RoomCare.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rc_home_view_invoices" app:icon="@drawable/ic_card" android:layout_marginTop="8dp" />
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/RoomCare.Section" android:text="@string/rc_home_updates" android:layout_marginTop="16dp" android:layout_marginBottom="6dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/notifications" style="@style/RoomCare.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rc_notifications" app:icon="@drawable/rc_bell" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/RoomCare.Section" android:text="@string/rc_home_shortcuts" android:layout_marginTop="16dp" android:layout_marginBottom="6dp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<com.google.android.material.button.MaterialButton android:id="@+id/incidents" style="@style/RoomCare.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/rc_incidents" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:textSize="11sp" app:icon="@drawable/ic_info" app:iconGravity="top" />
<com.google.android.material.button.MaterialButton android:id="@+id/contract" style="@style/RoomCare.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/rc_home_contract" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:textSize="11sp" app:icon="@drawable/ic_description" app:iconGravity="top" />
<com.google.android.material.button.MaterialButton android:id="@+id/profile" style="@style/RoomCare.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/rc_tenant_tab_profile" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:textSize="11sp" app:icon="@drawable/ic_person" app:iconGravity="top" />
</LinearLayout>
<TextView android:id="@+id/sample" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/RoomCare.Caption" android:text="@string/rc_tenant_sample" android:layout_marginTop="8dp" />
</LinearLayout>
</ScrollView>
