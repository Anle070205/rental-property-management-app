<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/RoomCare.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/rc_icon_box_tint">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_room"
                    app:tint="@color/rc_brand" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRoomCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rc_ink"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="Phòng P101" />

                <TextView
                    android:id="@+id/tvRoomMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/rc_muted"
                    android:textSize="12sp"
                    tools:text="Tầng 1 • 25 m² • Tối đa 2 người" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rc_badge_success"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/success"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Còn trống" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRentPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/rc_brand"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="3.500.000 ₫/tháng" />

            <TextView
                android:id="@+id/tvDeposit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/rc_muted"
                android:textSize="12sp"
                tools:text="Cọc: 3.500.000 ₫" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAmenities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/rc_ink"
            android:textSize="12sp"
            tools:text="Tiện nghi: Điều hòa, Bình nóng lạnh, Giường, Tủ, Wifi" />

        <TextView
            android:id="@+id/tvUtilitiesSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/rc_muted"
            android:textSize="11sp"
            tools:text="Điện 3.500 ₫/kWh • Nước 15.000 ₫/m³ • Wifi 100.000 ₫" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHealthScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rc_badge_success"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:textColor="@color/health_good"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Health Score: 100/100" />

            <TextView
                android:id="@+id/tvPendingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/rc_badge_warning"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:text="Đã gửi yêu cầu"
                android:textColor="@color/warning"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xem chi tiết →"
                android:textColor="@color/rc_brand"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
