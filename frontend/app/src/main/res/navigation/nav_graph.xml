<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Splash Screen - Check authentication status -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.rental_property_management_app.fragments.SplashFragment"
        android:label="RoomCare">
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_landlordDashboardFragment"
            app:destination="@id/landlordDashboardFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_tenantDashboardFragment"
            app:destination="@id/tenantDashboardFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Authentication Flow -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.rental_property_management_app.fragments.LoginFragment"
        android:label="Đăng nhập">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />
        <action
            android:id="@+id/action_loginFragment_to_landlordDashboardFragment"
            app:destination="@id/landlordDashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_tenantDashboardFragment"
            app:destination="@id/tenantDashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.rental_property_management_app.fragments.RegisterFragment"
        android:label="Đăng ký">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.example.rental_property_management_app.fragments.ForgotPasswordFragment"
        android:label="Quên mật khẩu" />

    <!-- Landlord Dashboard -->
    <fragment
        android:id="@+id/landlordDashboardFragment"
        android:name="com.example.rental_property_management_app.fragments.LandlordDashboardFragment"
        android:label="Dashboard - Chủ nhà">
        <action
            android:id="@+id/action_landlordDashboard_to_roomList"
            app:destination="@id/roomListFragment" />
        <action
            android:id="@+id/action_landlordDashboard_to_tenantList"
            app:destination="@id/tenantListFragment" />
    </fragment>

    <!-- Phase 2: Room Management -->
    <fragment
        android:id="@+id/roomListFragment"
        android:name="com.example.rental_property_management_app.fragments.RoomListFragment"
        android:label="@string/room_management">
        <action
            android:id="@+id/action_roomList_to_roomDetail"
            app:destination="@id/roomDetailFragment" />
        <action
            android:id="@+id/action_roomList_to_roomForm"
            app:destination="@id/roomFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/roomDetailFragment"
        android:name="com.example.rental_property_management_app.fragments.RoomDetailFragment"
        android:label="@string/room_detail">
        <argument
            android:name="roomId"
            app:argType="long" />
        <action
            android:id="@+id/action_roomDetail_to_roomForm"
            app:destination="@id/roomFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/roomFormFragment"
        android:name="com.example.rental_property_management_app.fragments.RoomFormFragment"
        android:label="@string/room_form">
        <argument
            android:name="roomId"
            android:defaultValue="0L"
            app:argType="long" />
        <argument
            android:name="propertyId"
            android:defaultValue="0L"
            app:argType="long" />
        <action
            android:id="@+id/action_roomForm_to_propertySelection"
            app:destination="@id/propertySelectionFragment" />
    </fragment>

    <fragment
        android:id="@+id/propertySelectionFragment"
        android:name="com.example.rental_property_management_app.fragments.PropertySelectionFragment"
        android:label="@string/select_property" />

    <!-- Phase 2: Tenant Management -->
    <fragment
        android:id="@+id/tenantListFragment"
        android:name="com.example.rental_property_management_app.fragments.TenantListFragment"
        android:label="@string/tenant_management">
        <action
            android:id="@+id/action_tenantList_to_tenantDetail"
            app:destination="@id/tenantDetailFragment" />
        <action
            android:id="@+id/action_tenantList_to_tenantForm"
            app:destination="@id/tenantFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/tenantDetailFragment"
        android:name="com.example.rental_property_management_app.fragments.TenantDetailFragment"
        android:label="@string/tenant_detail">
        <argument
            android:name="tenantId"
            app:argType="long" />
        <action
            android:id="@+id/action_tenantDetail_to_tenantForm"
            app:destination="@id/tenantFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/tenantFormFragment"
        android:name="com.example.rental_property_management_app.fragments.TenantFormFragment"
        android:label="@string/tenant_form">
        <argument
            android:name="tenantId"
            android:defaultValue="0L"
            app:argType="long" />
        <argument
            android:name="roomId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <!-- Tenant Dashboard -->
    <fragment
        android:id="@+id/tenantDashboardFragment"
        android:name="com.example.rental_property_management_app.fragments.TenantDashboardFragment"
        android:label="Dashboard - Người thuê">
        <!-- TODO: Add actions to other tenant screens in future phases -->
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.rental_property_management_app.fragments.ProfileFragment"
        android:label="@string/rc_profile" />

</navigation>
