<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Splash Screen - Check authentication status -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.rental_property_management_app.fragments.SplashFragment"
        android:label="RoomCare">
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_landlordDashboardFragment"
            app:destination="@id/landlordDashboardFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_tenantDashboardFragment"
            app:destination="@id/tenantDashboardFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_adminDashboardFragment"
            app:destination="@id/adminDashboardFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Authentication Flow -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.rental_property_management_app.fragments.LoginFragment"
        android:label="Đăng nhập">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />
        <action
            android:id="@+id/action_loginFragment_to_verifyOtpFragment"
            app:destination="@id/verifyOtpFragment" />
        <action
            android:id="@+id/action_loginFragment_to_landlordDashboardFragment"
            app:destination="@id/landlordDashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_tenantDashboardFragment"
            app:destination="@id/tenantDashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_adminDashboardFragment"
            app:destination="@id/adminDashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.rental_property_management_app.fragments.RegisterFragment"
        android:label="Đăng ký">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_registerFragment_to_verifyOtpFragment"
            app:destination="@id/verifyOtpFragment" />
        <action
            android:id="@+id/action_registerFragment_to_landlordDashboardFragment"
            app:destination="@id/landlordDashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_registerFragment_to_tenantDashboardFragment"
            app:destination="@id/tenantDashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/verifyOtpFragment"
        android:name="com.example.rental_property_management_app.fragments.VerifyOtpFragment"
        android:label="Xác thực OTP">
        <action
            android:id="@+id/action_verifyOtpFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/activateAccountFragment"
        android:name="com.example.rental_property_management_app.fragments.ActivateAccountFragment"
        android:label="Kích hoạt tài khoản" />

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.example.rental_property_management_app.fragments.ForgotPasswordFragment"
        android:label="Quên mật khẩu">
        <action
            android:id="@+id/action_forgotPasswordFragment_to_resetPasswordFragment"
            app:destination="@id/resetPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/resetPasswordFragment"
        android:name="com.example.rental_property_management_app.fragments.ResetPasswordFragment"
        android:label="Đặt lại mật khẩu">
        <action
            android:id="@+id/action_resetPasswordFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Landlord Dashboard (GĐ4.6 Unified Landlord Home) -->
    <fragment
        android:id="@+id/landlordDashboardFragment"
        android:name="com.example.rental_property_management_app.fragments.LandlordHomeFragment"
        android:label="@string/dashboard_home_title">
        <action
            android:id="@+id/action_landlordDashboard_to_roomList"
            app:destination="@id/roomListFragment" />
        <action
            android:id="@+id/action_landlordDashboard_to_tenantList"
            app:destination="@id/tenantListFragment" />
        <action
            android:id="@+id/action_landlordDashboard_to_invoiceFragment"
            app:destination="@id/invoiceFragment" />
        <action
            android:id="@+id/action_landlordDashboard_to_utilityFragment"
            app:destination="@id/utilityFragment" />
        <action
            android:id="@+id/action_landlordDashboard_to_debtFragment"
            app:destination="@id/debtFragment" />
        <action
            android:id="@+id/action_landlordDashboard_to_healthScoreFragment"
            app:destination="@id/healthScoreFragment" />
    </fragment>

    <!-- Phase 2: Room Management -->
    <fragment
        android:id="@+id/roomListFragment"
        android:name="com.example.rental_property_management_app.fragments.RoomListFragment"
        android:label="@string/room_management">
        <action
            android:id="@+id/action_roomList_to_roomDetail"
            app:destination="@id/roomDetailFragment" />
        <action
            android:id="@+id/action_roomList_to_roomForm"
            app:destination="@id/roomFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/roomDetailFragment"
        android:name="com.example.rental_property_management_app.fragments.RoomDetailFragment"
        android:label="@string/room_detail">
        <argument
            android:name="roomId"
            app:argType="long" />
        <action
            android:id="@+id/action_roomDetail_to_roomForm"
            app:destination="@id/roomFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/roomFormFragment"
        android:name="com.example.rental_property_management_app.fragments.RoomFormFragment"
        android:label="@string/room_form">
        <argument
            android:name="roomId"
            android:defaultValue="0L"
            app:argType="long" />
        <argument
            android:name="propertyId"
            android:defaultValue="0L"
            app:argType="long" />
        <action
            android:id="@+id/action_roomForm_to_propertySelection"
            app:destination="@id/propertySelectionFragment" />
    </fragment>

    <fragment
        android:id="@+id/propertySelectionFragment"
        android:name="com.example.rental_property_management_app.fragments.PropertySelectionFragment"
        android:label="@string/select_property">
        <argument
            android:name="selectMode"
            android:defaultValue="true"
            app:argType="boolean" />
    </fragment>

    <!-- Phase 2: Tenant Management -->
    <fragment
        android:id="@+id/tenantListFragment"
        android:name="com.example.rental_property_management_app.fragments.TenantListFragment"
        android:label="@string/tenant_management">
        <action
            android:id="@+id/action_tenantList_to_tenantDetail"
            app:destination="@id/tenantDetailFragment" />
        <action
            android:id="@+id/action_tenantList_to_tenantForm"
            app:destination="@id/tenantFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/tenantDetailFragment"
        android:name="com.example.rental_property_management_app.fragments.TenantDetailFragment"
        android:label="@string/tenant_detail">
        <argument
            android:name="tenantId"
            app:argType="long" />
        <action
            android:id="@+id/action_tenantDetail_to_tenantForm"
            app:destination="@id/tenantFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/tenantFormFragment"
        android:name="com.example.rental_property_management_app.fragments.TenantFormFragment"
        android:label="@string/tenant_form">
        <argument
            android:name="tenantId"
            android:defaultValue="0L"
            app:argType="long" />
        <argument
            android:name="roomId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <!-- Tenant Dashboard -->
    <fragment
        android:id="@+id/tenantDashboardFragment"
        android:name="com.example.rental_property_management_app.fragments.TenantHomeFragment"
        android:label="Dashboard - Người thuê">
        <action android:id="@+id/action_tenantHome_to_incidents" app:destination="@id/incidentListFragment" />
        <action android:id="@+id/action_tenantHome_to_room" app:destination="@id/myRoomFragment" />
        <action android:id="@+id/action_tenantHome_to_contract" app:destination="@id/myContractFragment" />
        <action android:id="@+id/action_tenantHome_to_invoices" app:destination="@id/tenantInvoiceFragment" />
    </fragment>


    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.rental_property_management_app.fragments.ProfileFragment"
        android:label="@string/rc_profile" />

    <fragment
        android:id="@+id/notificationFragment"
        android:name="com.example.rental_property_management_app.fragments.NotificationFragment"
        android:label="@string/rc_notifications" />

    <fragment
        android:id="@+id/incidentListFragment"
        android:name="com.example.rental_property_management_app.fragments.IncidentListFragment"
        android:label="@string/rc_incidents" />
    <fragment
        android:id="@+id/incidentFormFragment"
        android:name="com.example.rental_property_management_app.fragments.IncidentFormFragment"
        android:label="@string/rc_report_incident">
        <argument android:name="incidentId" android:defaultValue="0L" app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/incidentDetailFragment"
        android:name="com.example.rental_property_management_app.fragments.IncidentDetailFragment"
        android:label="@string/rc_incident_detail">
        <argument android:name="incidentId" app:argType="long" />
    </fragment>
    <fragment android:id="@+id/myRoomFragment"
        android:name="com.example.rental_property_management_app.fragments.MyRoomFragment" android:label="@string/rc_my_room" />
    <fragment android:id="@+id/myContractFragment"
        android:name="com.example.rental_property_management_app.fragments.MyContractFragment" android:label="@string/rc_my_contract" />
    <fragment android:id="@+id/tenantInvoiceFragment"
        android:name="com.example.rental_property_management_app.fragments.TenantInvoiceFragment" android:label="@string/rc_tenant_invoices" />
    <fragment android:id="@+id/tenantInvoiceDetailFragment"
        android:name="com.example.rental_property_management_app.fragments.TenantInvoiceDetailFragment" android:label="@string/rc_invoice_detail">
        <argument android:name="invoiceId" app:argType="long" />
    </fragment>
    <fragment android:id="@+id/qrPaymentFragment"
        android:name="com.example.rental_property_management_app.fragments.QRPaymentFragment" android:label="@string/rc_payment_qr">
        <argument android:name="invoiceId" app:argType="long" />
    </fragment>
    <fragment android:id="@+id/paymentHistoryFragment"
        android:name="com.example.rental_property_management_app.fragments.PaymentHistoryFragment" android:label="@string/rc_payment_history" />

    <!-- Phase 4: Member 2 - Finance, Utilities, Debt & Health Score -->
    <fragment
        android:id="@+id/invoiceFragment"
        android:name="com.example.rental_property_management_app.fragments.InvoiceFragment"
        android:label="@string/invoice_management">
        <action
            android:id="@+id/action_invoiceFragment_to_invoiceDetailFragment"
            app:destination="@id/invoiceDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/invoiceDetailFragment"
        android:name="com.example.rental_property_management_app.fragments.InvoiceDetailFragment"
        android:label="@string/invoice_detail">
        <argument
            android:name="invoiceId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/utilityFragment"
        android:name="com.example.rental_property_management_app.fragments.UtilityFragment"
        android:label="@string/utility_management" />

    <fragment
        android:id="@+id/debtFragment"
        android:name="com.example.rental_property_management_app.fragments.DebtFragment"
        android:label="@string/debt_management">
        <action
            android:id="@+id/action_debtFragment_to_invoiceDetailFragment"
            app:destination="@id/invoiceDetailFragment" />
        <action
            android:id="@+id/action_debtFragment_to_tenantDetailFragment"
            app:destination="@id/tenantDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/healthScoreFragment"
        android:name="com.example.rental_property_management_app.fragments.HealthScoreFragment"
        android:label="@string/health_score_title">
        <argument
            android:name="roomId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <!-- Marketplace, Booking & Contact -->
    <fragment
        android:id="@+id/tenantPropertyListFragment"
        android:name="com.example.rental_property_management_app.fragments.TenantPropertyListFragment"
        android:label="@string/rc_browse_properties" />

    <fragment
        android:id="@+id/tenantPropertyRoomsFragment"
        android:name="com.example.rental_property_management_app.fragments.TenantPropertyRoomsFragment"
        android:label="@string/room_list">
        <argument
            android:name="propertyId"
            app:argType="long" />
        <argument
            android:name="propertyName"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/tenantMarketplaceRoomDetailFragment"
        android:name="com.example.rental_property_management_app.fragments.TenantMarketplaceRoomDetailFragment"
        android:label="@string/room_detail">
        <argument
            android:name="roomId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/tenantBookingListFragment"
        android:name="com.example.rental_property_management_app.fragments.TenantBookingListFragment"
        android:label="@string/rc_my_bookings" />

    <fragment
        android:id="@+id/landlordBookingListFragment"
        android:name="com.example.rental_property_management_app.fragments.LandlordBookingListFragment"
        android:label="@string/rc_booking_requests" />

    <fragment
        android:id="@+id/contractListFragment"
        android:name="com.example.rental_property_management_app.fragments.ContractListFragment"
        android:label="Quản lý hợp đồng" />

    <fragment
        android:id="@+id/contractDetailFragment"
        android:name="com.example.rental_property_management_app.fragments.ContractDetailFragment"
        android:label="Chi tiết hợp đồng">
        <argument
            android:name="contractId"
            app:argType="long" />
    </fragment>


    <!-- Admin Management Flow -->
    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.example.rental_property_management_app.fragments.AdminDashboardFragment"
        android:label="Tổng quan hệ thống" />
    <fragment
        android:id="@+id/adminAccountListFragment"
        android:name="com.example.rental_property_management_app.fragments.AdminAccountListFragment"
        android:label="Quản lý tài khoản" />
    <fragment
        android:id="@+id/adminAccountDetailFragment"
        android:name="com.example.rental_property_management_app.fragments.AdminAccountDetailFragment"
        android:label="Chi tiết tài khoản" />
    <fragment
        android:id="@+id/adminAccountFormFragment"
        android:name="com.example.rental_property_management_app.fragments.AdminAccountFormFragment"
        android:label="Tài khoản" />
    <fragment
        android:id="@+id/adminLandlordListFragment"
        android:name="com.example.rental_property_management_app.fragments.AdminLandlordListFragment"
        android:label="Quản lý chủ nhà" />
    <fragment
        android:id="@+id/adminLandlordDetailFragment"
        android:name="com.example.rental_property_management_app.fragments.AdminLandlordDetailFragment"
        android:label="Chi tiết chủ nhà" />
    <fragment
        android:id="@+id/adminPropertyListFragment"
        android:name="com.example.rental_property_management_app.fragments.AdminPropertyListFragment"
        android:label="Quản lý nhà trọ" />
    <fragment
        android:id="@+id/adminPropertyDetailFragment"
        android:name="com.example.rental_property_management_app.fragments.AdminPropertyDetailFragment"
        android:label="Chi tiết nhà trọ" />
    <fragment
        android:id="@+id/adminReportListFragment"
        android:name="com.example.rental_property_management_app.fragments.AdminReportListFragment"
        android:label="Quản lý báo cáo" />
    <fragment
        android:id="@+id/adminReportDetailFragment"
        android:name="com.example.rental_property_management_app.fragments.AdminReportDetailFragment"
        android:label="Chi tiết báo cáo" />
    <fragment
        android:id="@+id/adminBroadcastListFragment"
        android:name="com.example.rental_property_management_app.fragments.AdminBroadcastListFragment"
        android:label="Quản lý thông báo" />
    <fragment
        android:id="@+id/adminBroadcastDetailFragment"
        android:name="com.example.rental_property_management_app.fragments.AdminBroadcastDetailFragment"
        android:label="Chi tiết thông báo" />
    <fragment
        android:id="@+id/adminBroadcastFormFragment"
        android:name="com.example.rental_property_management_app.fragments.AdminBroadcastFormFragment"
        android:label="Soạn thông báo" />
    <fragment
        android:id="@+id/adminHubFragment"
        android:name="com.example.rental_property_management_app.fragments.AdminHubFragment"
        android:label="Trung tâm quản trị" />
    <fragment
        android:id="@+id/adminProfileFragment"
        android:name="com.example.rental_property_management_app.fragments.AdminProfileFragment"
        android:label="Hồ sơ Admin" />
    <fragment
        android:id="@+id/adminChangePasswordFragment"
        android:name="com.example.rental_property_management_app.fragments.AdminChangePasswordFragment"
        android:label="Đổi mật khẩu" />
</navigation>
