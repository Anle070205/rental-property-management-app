<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.Rentalpropertymanagementapp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- RoomCare Brand Teal Colors -->
        <item name="colorPrimary">@color/rc_brand</item>
        <item name="colorPrimaryVariant">@color/rc_brand_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/rc_brand_light</item>
        <item name="colorSecondaryVariant">@color/rc_brand</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/rc_brand_dark</item>
    </style>
</resources>
