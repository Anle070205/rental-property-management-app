<resources>
    <style name="RoomCare.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="titleTextColor">@color/rc_ink</item>
        <item name="navigationIconTint">@color/rc_ink</item>
    </style>

    <style name="RoomCare.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/rc_brand</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="iconTint">@android:color/white</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="RoomCare.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/white</item>
        <item name="android:textColor">@color/rc_brand</item>
        <item name="iconTint">@color/rc_brand</item>
        <item name="strokeColor">@color/rc_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="RoomCare.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/rc_tint</item>
        <item name="android:textColor">@color/rc_brand</item>
        <item name="iconTint">@color/rc_brand</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="RoomCare.Button.Danger" parent="RoomCare.Button">
        <item name="backgroundTint">@color/rc_danger</item>
    </style>

    <style name="RoomCare.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@android:color/white</item>
        <item name="boxStrokeColor">@color/rc_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/rc_brand</item>
    </style>

    <style name="RoomCare.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/rc_ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RoomCare.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/rc_ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RoomCare.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/rc_muted</item>
    </style>

    <style name="RoomCare.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/rc_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="RoomCare.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/rc_tint</item>
    </style>
</resources>
